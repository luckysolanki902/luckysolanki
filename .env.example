MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=luckyportfolio

# Server-only. Replace the placeholder and redeploy to enable AI replies.
OPENAI_API_KEY=sk-proj....
OPENAI_MODEL=gpt-5-nano
# Shared daily limit across all visitors. Requires the MongoDB settings above.
PIP_DAILY_LIMIT=500
# A stable, random server-only secret for signed visitor cookies and IP hashing.
PIP_IDENTITY_SECRET=replace-with-a-random-secret
